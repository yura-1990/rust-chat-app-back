# cp .env.example .env, then fill in your own DB creds.
# All vars optional — defaults shown are what config.rs falls back to.

# Bind address for the HTTP + WebSocket server.
GATEWAY_ADDR=127.0.0.1:8080

# Postgres connection string. postgres://<user>:<password>@<host>:<port>/<db>
# Omit ":<password>" for trust-auth setups (e.g. native Laragon Postgres).
DATABASE_URL=postgres://chat@127.0.0.1:5433/chat

# NATS server address (host:port, no scheme).
NATS_URL=127.0.0.1:4222

# HS256 signing secret for auth JWTs. Set a real value outside dev.
JWT_SECRET=dev-only-insecure-secret-change-me

# Local directory for uploaded media.
MEDIA_DIR=.data/media
